APP_NAME=Cestos Operations
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://cestos:cestos_local@localhost:5432/cestos
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REDIS_URL=
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=10
POSTGRES_PASSWORD=cestos_local
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=
# Tests require a DIFFERENT database, with a name ending in _test.
TEST_DATABASE_URL=postgresql+psycopg://cestos:cestos_local@localhost:5432/cestos_test
# HR reminder scheduler and SMTP (messages queue until SMTP is configured).
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Public FRONTEND URL used in setup links and alert emails (HTTPS in production).
PUBLIC_BASE_URL=http://localhost:8000/test-ui

# Enable implicit TLS for port 465; disable SMTP_STARTTLS when using SSL.
SMTP_USE_SSL=false
